# ── Hyperlocal Rainfall Nowcasting — Environment Variables ───────────
# Copy this file to .env and fill in values.

# Ambient Weather API (get from ambientweather.net/account)
AMBIENT_API_KEY=
AMBIENT_APP_KEY=

# Open-Meteo (free, no key needed)
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# IMD AWS API (pending approval — leave blank until received)
IMD_API_TOKEN=

# Database (default: SQLite for local dev)
# For production: postgresql+asyncpg://user:pass@host:5432/nowcast
DATABASE_URL=sqlite+aiosqlite:///./weather.db

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Ingestion interval in minutes
INGESTION_INTERVAL_MINUTES=10

# ── Auth (Phase 2) ──────────────────────────────────────────────────
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
